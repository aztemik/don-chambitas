# ============================================================================
#  DON CHAMBITAS  ·  plantilla de variables de entorno
# ============================================================================
#  Copia este archivo a .env y pon los valores reales:
#
#      cp .env.ejemplo .env
#
#  .env esta en .gitignore y NUNCA se sube. Esta plantilla si, y por eso no
#  lleva ni un valor real: si alguna vez ves algo que parece una llave aqui
#  dentro, esa llave ya esta quemada y hay que rotarla.
#
#  PARA QUE SIRVE. Para los guiones que hablan con el proyecto de Supabase
#  desde fuera de la aplicacion, hoy solo 92_prueba_rls_anon.py, que es el
#  paso 2c de S1-T03. La APLICACION no lee este archivo: ella toma la URL y la
#  anon key de local.properties via BuildConfig. Son dos caminos distintos
#  para los mismos dos valores, a proposito, porque Gradle y un guion suelto
#  no leen lo mismo.
#
#  Las dos estan en la consola de Supabase:
#      Project Settings -> API -> Project URL y Project API keys -> anon public
# ============================================================================

# URL del proyecto. Sin diagonal al final.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# La anon key. Es PUBLICA por diseno: va dentro del APK y cualquiera la saca.
# Lo unico que protege los datos son las politicas RLS de
# basedatos/02_politicas_rls.sql. Por eso ese archivo no es opcional.
SUPABASE_ANON_KEY=pon-aqui-la-anon-key

# ============================================================================
#  LO QUE NUNCA VA EN ESTE ARCHIVO, NI EN .env, NI EN NINGUN OTRO DEL REPO
# ============================================================================
#  SUPABASE_SERVICE_ROLE_KEY  se salta TODAS las politicas RLS. Vive en las
#                             variables de entorno de la Edge Function y en la
#                             consola de Supabase. En ningun otro lado.
#  OPENAI_API_KEY             vive en la Edge Function. Ver docs/producto/IA.md
#                             y la regla de AGENTS.md: nunca, por ningun
#                             motivo, ni en pruebas.
#
#  Un guion que necesite la service_role no se escribe: se hace desde la
#  consola.
# ============================================================================
